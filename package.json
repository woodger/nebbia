{
  "name": "nebbia",
  "version": "3.0.8",
  "description": "JavaScript Template literals (Template strings) compiler",
  "keywords": [
    "template literals",
    "compiler"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/woodger/nebbia.git"
  },
  "bugs": {
    "url": "https://github.com/woodger/nebbia/issues"
  },
  "homepage": "https://github.com/woodger/nebbia#readme",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=18.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "fwa": "^2.1.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  }
}
